<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            force="true" is REQUIRED: without it PHPUnit only sets these
            variables when they are NOT already present in the environment.
            When tests are launched via `php artisan test`, the parent artisan
            process has already loaded .env (absolute sqlite file path) and the
            child inherits those values, so a plain <env> would be skipped and
            RefreshDatabase would reset the FILE-BASED DEVELOPMENT database.

            The <server> entries are equally required: PHPUnit's <env>
            handler updates putenv() and $_ENV but NOT $_SERVER, and Laravel's
            Env repository reads $_SERVER first — so without <server>
            overrides, config('database.connections.sqlite.database') would
            still resolve to the development file path.
        -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Dedicated biometric encryption key for the test suite. This is a
            fixed neutral test fixture (32 zero bytes), NOT a production secret.
            Production deployments set their own BIOMETRICS_ENCRYPTION_KEY.
        -->
        <env name="BIOMETRICS_ENCRYPTION_KEY" value="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <server name="BIOMETRICS_ENCRYPTION_KEY" value="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
    </php>
</phpunit>
