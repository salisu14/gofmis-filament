APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ----------------------------------------------------------------------------
# Biometric template encryption (secret, DO NOT commit a real value)
#
# Fingerprint templates are encrypted separately from APP_KEY using a dedicated
# biometric encryption key. Generate one with:
#
#   php -r "echo base64_encode(random_bytes(32));"
#
# The value MUST be a base64-encoded 32-byte key (aes-256-cbc). The application
# fails safely (Refuses to write) if this key is missing or invalid; it never
# silently falls back to APP_KEY for new templates.
#
#   BIOMETRICS_ENCRYPTION_KEY=base64:of/your/dedicated/32/byte/biometric/key....
#
# Optional: set the key version used at write time (default 1).
#   BIOMETRICS_ENCRYPTION_KEY_VERSION=1
# ----------------------------------------------------------------------------
BIOMETRICS_ENCRYPTION_KEY=

# Biometric bridge / scanner client selection (mock|http)
#   mock = in-process mock client (development/testing; NO physical scanner)
#   http = real local scanner bridge via HTTP (production)
BIOMETRICS_CLIENT=mock

# Local/trusted scanner bridge endpoint. MUST come only from server config;
# never accept this from request/Livewire/beneficiary input.
BIOMETRICS_BRIDGE_URL=http://127.0.0.1:8787

# Optional bearer token for the bridge. Isolated from APP_KEY and
# BIOMETRICS_ENCRYPTION_KEY. Never reuse APP_KEY as an HTTP auth secret.
BIOMETRICS_BRIDGE_TOKEN=

# Bridge timeouts (seconds). Capture is interactive, so allow a generous window.
BIOMETRICS_BRIDGE_CONNECT_TIMEOUT=3
BIOMETRICS_BRIDGE_TIMEOUT=30

# Maximum accepted fingerprint template payload size (bytes). Oversized
# payloads are rejected to protect the app/database.
BIOMETRICS_MAX_TEMPLATE_BYTES=65536

# Mock client low-quality forcing (testing only).
BIOMETRICS_MOCK_FORCE_LOW_QUALITY=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gofmis_filament
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
